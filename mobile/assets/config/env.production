# FlipSync Production Environment Configuration
# This file contains production environment variables for the FlipSync mobile app

# API Configuration - Production Backend (HTTPS - STANDARDIZED)
API_BASE_URL=https://www.flipsyncai.com/api/v1
API_TIMEOUT=30000
BASE_URL=https://www.flipsyncai.com

# WebSocket Configuration - Production (WSS - STANDARDIZED)
WS_BASE_URL=wss://www.flipsyncai.com
WEBSOCKET_URL=wss://www.flipsyncai.com/ws/flipsync

# Environment Settings
ENVIRONMENT=production
DEBUG_MODE=false
LOGGING_ENABLED=true

# Feature Flags
USE_MOCK_DATA=false
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=false
ENABLE_BIOMETRICS=false

# Authentication
AUTH_TIMEOUT=3600

# Marketplace Integration - Production Mode
EBAY_SANDBOX_MODE=false
AMAZON_SANDBOX_MODE=false

# eBay OAuth Configuration - Production (STANDARDIZED URLs)
EBAY_OAUTH_ENABLED=true
EBAY_CLIENT_ID=SECURE_CREDENTIAL_REQUIRED
EBAY_RU_NAME=SECURE_CREDENTIAL_REQUIRED
EBAY_CALLBACK_URL=https://www.flipsyncai.com/api/v1/marketplace/ebay/oauth/callback
EBAY_ENVIRONMENT=production

# Performance - Production Optimized
CACHE_ENABLED=true
OFFLINE_MODE_ENABLED=true
ENABLE_OFFLINE_MODE=true

# Authentication Configuration - Production (SECURE)
AUTH_SECRET=SECURE_CREDENTIAL_REQUIRED
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Metrics Configuration - Production
METRICS_ENDPOINT=/api/v1/metrics
METRICS_UPDATE_INTERVAL=15

# Gemini Configuration - Production (FlipSync uses Gemini for conversational interface)
GEMINI_API_KEY=SECURE_CREDENTIAL_REQUIRED
GEMINI_MODEL=gemini-pro
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=1000
LLM_PROVIDER=gemini
USE_GEMINI_PRIMARY=true

# Security Configuration - Production
SSL_ENABLED=true
HTTPS_REDIRECT=true
SECURITY_MIDDLEWARE_ENABLED=true

# WebSocket Configuration - Production
WS_RECONNECT_ATTEMPTS=5
WS_RECONNECT_DELAY_SECONDS=5
WS_PING_INTERVAL_SECONDS=30
WEBSOCKET_ENABLED=true
AGENT_STREAMING_ENABLED=true

# Security
CERTIFICATE_PINNING_ENABLED=false
BIOMETRIC_AUTH_ENABLED=false
