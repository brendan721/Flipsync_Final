# FlipSync Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env files with real secrets to git!

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
ENVIRONMENT=development
TESTING_MODE=False

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Database Connection
DATABASE_URL=postgresql+asyncpg://postgres:FlipSync_DB_Prod_2024_Secure_Key_9x7z@174.138.77.110:5432/flipsync_agentic_test_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flipsync_db
DB_USER=username
DB_PASSWORD=your_database_password

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis for caching and session storage
REDIS_URL=redis://:your_redis_password@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# =============================================================================
# VECTOR DATABASE (QDRANT)
# =============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333

# =============================================================================
# AI SERVICE API KEYS
# =============================================================================
# Google Gemini API Key (required for all AI features)
GEMINI_API_KEY=your-gemini-api-key-here

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Secret for token signing (use a long, random string)
JWT_SECRET=your-very-long-and-secure-jwt-secret-key-here-minimum-32-characters

# Authentication service type
AUTH_SERVICE_TYPE=database

# =============================================================================
# EBAY INTEGRATION
# =============================================================================
# eBay Production Credentials
EBAY_APP_ID=your-ebay-app-id
EBAY_DEV_ID=your-ebay-dev-id
EBAY_CERT_ID=your-ebay-cert-id
EBAY_CLIENT_SECRET=your-ebay-client-secret

# eBay Sandbox Credentials (for testing)
EBAY_SANDBOX_APP_ID=your-sandbox-app-id
EBAY_SANDBOX_CLIENT_SECRET=your-sandbox-client-secret
EBAY_SANDBOX_USER=your-sandbox-test-user

# eBay OAuth Configuration
EBAY_RUNAME=your-ebay-runame
EBAY_REDIRECT_URI=https://your-domain.com/auth/ebay/callback

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Server host and port
HOST=0.0.0.0
PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/flipsync.log

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Shippo API for shipping
SHIPPO_API_KEY=your-shippo-api-key

# Email service configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Set to True for development mode
DEBUG=False

# Set to True to enable detailed logging
VERBOSE_LOGGING=False

# =============================================================================
# PRODUCTION DEPLOYMENT NOTES
# =============================================================================
# For production deployment:
# 1. Copy this file to .env
# 2. Replace all placeholder values with real credentials
# 3. Use strong, unique passwords and secrets
# 4. Never commit .env files to version control
# 5. Use environment-specific values for different deployments
# 6. Regularly rotate API keys and secrets
# 7. Use HTTPS in production
# 8. Set DEBUG=False in production
# 9. Configure proper CORS origins
# 10. Use secure JWT secrets (minimum 32 characters)
